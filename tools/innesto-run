#!/usr/bin/env python3
"""Start the supported local target with trusted Innesto mods."""

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import mmap
import os
from pathlib import Path
import platform
import re
import sys

from innesto_elf import ET_DYN, ET_EXEC, PT_DYNAMIC, PT_INTERP, elf_segments, verify_target_image
from innesto_packages import SelectedMod, select_packages, unique_keys
from innesto_terrain import start as start_with_terrain


LOADER_TOKEN = re.compile(r"\$(?:\{(?:ORIGIN|LIB|PLATFORM)\}|(?:ORIGIN|LIB|PLATFORM)(?![a-zA-Z0-9_]))")


def read_profile(path):
    with path.open(encoding="utf-8") as stream:
        data = json.load(stream, object_pairs_hook=unique_keys)
    if not isinstance(data, dict):
        raise ValueError("target profile must be an object")
    if (data.get("version"), data.get("platform")) != ("a1.2.10", "linux-x86_64"):
        raise ValueError("unsupported target version or platform")
    executable = data.get("executable")
    if not isinstance(executable, str) or not Path(executable).is_absolute():
        raise ValueError("target profile requires an absolute executable path")
    digest = data.get("sha256")
    if not isinstance(digest, str) or not re.fullmatch(r"[a-fA-F0-9]{64}", digest):
        raise ValueError("target profile requires a SHA-256 fingerprint")
    environment = data.get("environment", "server")
    if environment not in ("client", "server"):
        raise ValueError("target environment must be 'client' or 'server'")
    return executable, digest.lower(), environment, data


def verify_bootstrap(loader, directory):
    stamp = directory / "innesto-bootstrap.sha256"
    try:
        expected = stamp.read_text(encoding="ascii").strip()
    except (OSError, UnicodeError) as exc:
        raise ValueError("could not read the bootstrap checksum from the Innesto build") from exc
    if expected.lower() != hashlib.file_digest(loader, "sha256").hexdigest():
        raise ValueError("loader does not match the Innesto bootstrap checksum")
    try:
        # The dynamic linker must be able to map code from this filesystem.
        with mmap.mmap(loader.fileno(), 1, flags=mmap.MAP_PRIVATE, prot=mmap.PROT_EXEC):
            pass
    except OSError as exc:
        raise ValueError("bootstrap file cannot be mapped for execution") from exc


def validate_mod_path(path):
    # dlopen expands these tokens even in absolute filenames. Unbraced
    # token names end at the first byte outside the ASCII identifier set.
    for part in path.parts:
        token = LOADER_TOKEN.search(part)
        if token:
            raise ValueError(f"dynamic loader token {token[0]!r} in mod path component {part!r}: "
                             "rename that file or directory before starting the target")


@contextmanager
def mod_list(environment, verified_digest, mods):
    with os.fdopen(os.memfd_create("innesto-mod-list", os.MFD_CLOEXEC), "wb") as plan:
        plan.write(b"Innesto/3\0" + environment.encode("ascii") + b"\0")
        plan.write(verified_digest.encode("ascii") + b"\0")
        for mod in mods:
            plan.write(str(mod.api).encode("ascii") + b"\0" + mod.mod_id.encode("ascii") + b"\0")
            plan.write(os.fsencode(mod.library) + b"\0")
        plan.seek(0)
        fd = fcntl.fcntl(plan.fileno(), fcntl.F_DUPFD_CLOEXEC, 3)
        with os.fdopen(fd, "rb") as inherited:
            yield inherited


def run(args):
    if sys.platform != "linux" or platform.machine() != "x86_64":
        raise ValueError("unsupported target platform")
    executable, expected_digest, environment, profile = read_profile(args.profile)
    # The executable descriptor stays open from validation through execve.
    with open(executable, "rb") as target:
        verify_target_image(target)
        verified_digest = hashlib.file_digest(target, "sha256").hexdigest()
        if verified_digest != expected_digest:
            raise ValueError("unsupported target fingerprint")

        if args.mods_dir is not None:
            mods = select_packages(args.mods_dir, environment)
        else:
            mod = args.mod.resolve(strict=True)
            if not mod.is_file():
                raise ValueError("mod must be a regular file")
            mods = [SelectedMod(mod, "", 1)]
        for mod in mods:
            validate_mod_path(mod.library)
        loader_path = args.loader.resolve(strict=True)
        with loader_path.open("rb") as loader:
            elf_type, segments = elf_segments(loader)
            if elf_type != ET_DYN or PT_DYNAMIC not in segments or PT_INTERP in segments:
                raise ValueError("loader must be a Linux x86-64 shared library")
            verify_bootstrap(loader, loader_path.parent)
            # LD_PRELOAD splits filenames at spaces and colons. An inherited
            # descriptor names this single loader independent of the checkout path.
            # Always use a nonstandard descriptor, including for daemon launches
            # with one or more of stdin, stdout and stderr closed.
            fd = fcntl.fcntl(loader.fileno(), fcntl.F_DUPFD_CLOEXEC, 3)
            with os.fdopen(fd, "rb") as inherited, mod_list(environment, verified_digest, mods) as plan:
                def launch(image, path, arguments, world_lease=None, *, exec_target=os.execve):
                    launch_target(image, path, inherited, plan, arguments, world_lease, exec_target)

                return start_with_terrain(target, executable, verified_digest, environment,
                                         mods, profile, args.target_args, launch, args.terrain_peer,
                                         migrate=args.migrate_terrain, preview=args.preview_terrain,
                                         remaps=args.remaps, backup=args.backup_world, packages=args.mods_dir,
                                         solo_world=args.solo_world, loader_path=loader_path)


def launch_target(target, executable, inherited, plan, arguments, world_lease=None, exec_target=os.execve):
    fd = inherited.fileno()
    preload = f"/proc/self/fd/{fd}"
    with open(preload, "rb") as proc_entry:
        if not os.path.samestat(os.fstat(fd), os.fstat(proc_entry.fileno())):
            raise ValueError("bootstrap descriptor is unavailable through procfs")
    env = os.environ.copy()
    previous = env.get("LD_PRELOAD")
    if previous is None:
        env.pop("INNESTO_PREVIOUS_PRELOAD", None)
    else:
        env["INNESTO_PREVIOUS_PRELOAD"] = previous
    env["LD_PRELOAD"] = preload + (f" {previous}" if previous else "")
    env["INNESTO_LOADER_FD"] = str(fd)
    env["INNESTO_INIT_PID"] = str(os.getpid())
    env.pop("INNESTO_MOD_PATH", None)
    env["INNESTO_MOD_LIST_FD"] = str(plan.fileno())
    if world_lease is None:
        env.pop("INNESTO_WORLD_LEASE_FD", None)
    else:
        env["INNESTO_WORLD_LEASE_FD"] = str(world_lease)
        os.set_inheritable(world_lease, True)
    os.set_inheritable(fd, True)
    os.set_inheritable(plan.fileno(), True)
    exec_target(target.fileno(), [executable, *arguments], env)


def main():
    if sys.argv[1:2] == ["--solo-reference"]:
        from adapters.a1_2_10.solo_reference import reference
        parser = argparse.ArgumentParser(description="Read private terrain pins from a trusted stock Solo session.")
        parser.add_argument("--solo-reference", type=Path, required=True, metavar="CLIENT_PROFILE")
        parser.add_argument("--stock-solo-log", type=Path, required=True, metavar="CONSOLE_LOG")
        args = parser.parse_args()
        try:
            executable, digest, environment, _ = read_profile(args.solo_reference)
            if environment != "client":
                raise ValueError("Solo reference requires a physical client profile")
            pins = reference(executable, digest, args.stock_solo_log)
        except (OSError, ValueError) as exc:
            parser.exit(1, f"innesto-run: {exc}\n")
        print(json.dumps(pins, indent=2))
        return 0
    if sys.argv[1:2] == ["--terrain-reference"]:
        reference = argparse.ArgumentParser(description="Print private terrain pins from a trusted stock installation and stock server.")
        reference.add_argument("--terrain-reference", type=Path, metavar="EXECUTABLE", required=True)
        reference.add_argument("--dashboard-host", default="127.0.0.1")
        reference.add_argument("--dashboard-port", required=True, type=int)
        settings = reference.parse_args()
        from adapters.a1_2_10 import terrain, terrain_peer
        try:
            stock = terrain.original_pack(settings.terrain_reference.resolve(strict=True))
            pins = {"terrainPackSha256": terrain.stock_fingerprint(stock),
                    "terrainBaseCount": terrain_peer.stock_count(settings.dashboard_host, settings.dashboard_port)}
        except (OSError, ValueError) as exc:
            reference.exit(1, f"innesto-run: {exc}\n")
        print(json.dumps(pins, indent=2))
        return 0
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", required=True, type=Path, help="private trusted target profile")
    parser.add_argument("--loader", required=True, type=Path, help="Innesto shared library")
    route = parser.add_mutually_exclusive_group()
    route.add_argument("--solo-world", type=Path, metavar="WORLD",
                       help="open one managed Survival world in the native client Solo menu")
    route.add_argument("--terrain-peer", metavar="HOST:PORT", help="preflight this terrain server before opening the client menu")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--preview-terrain", action="store_true", help="preview changes to a stopped terrain world")
    mode.add_argument("--migrate-terrain", action="store_true",
                        help="update the selected terrain world's registry offline")
    parser.add_argument("--remap-terrain", action="append", default=[], metavar="PERSISTENT_ID=PROVIDER_ID",
                        help="explicitly select the provider of a saved slot during preview or migration")
    parser.add_argument("--backup-world", type=Path, metavar="DIRECTORY",
                        help="write a complete pre-migration world copy to this separate directory")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--mod", type=Path, help="one mod shared library")
    source.add_argument("--mods-dir", type=Path, help="directory containing unpacked mod packages")
    parser.add_argument("target_args", nargs=argparse.REMAINDER, help="target arguments after --")
    args = parser.parse_args()
    if (args.migrate_terrain or args.preview_terrain) and not args.mods_dir:
        parser.error("offline terrain operations require --mods-dir")
    if args.solo_world is not None and not args.mods_dir:
        parser.error("--solo-world requires --mods-dir")
    if args.remap_terrain and not (args.migrate_terrain or args.preview_terrain):
        parser.error("--remap-terrain requires --preview-terrain or --migrate-terrain")
    if args.backup_world and not args.migrate_terrain:
        parser.error("--backup-world requires --migrate-terrain")
    args.remaps = {}
    for assignment in args.remap_terrain:
        stable, sep, provider = assignment.partition("=")
        if not sep or not stable or not provider or "=" in provider or stable in args.remaps:
            parser.error("supply one PERSISTENT_ID=PROVIDER_ID per saved material")
        args.remaps[stable] = provider
    if args.target_args[:1] == ["--"]:
        args.target_args = args.target_args[1:]
    try:
        return run(args)
    except OSError as exc:
        parser.exit(1, f"innesto-run: {exc.strerror}\n")
    except ValueError as exc:
        parser.exit(1, f"innesto-run: {exc}\n")


if __name__ == "__main__":
    sys.exit(main())
